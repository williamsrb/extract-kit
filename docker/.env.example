# Copy to docker/.env and fill in. Names only: never commit values.

# Folder of the legacy checkout to mount at /work.
LEGACY_DIR=

# Agent CLI and its credential. EXTRACTKIT_AGENT_API_KEY reaches the chosen
# agent as its own variable (CLAUDE_CODE_OAUTH_TOKEN, OPENAI_API_KEY or
# CURSOR_API_KEY); for claude it is a `claude setup-token` token.
EXTRACTKIT_AGENT=claude
EXTRACTKIT_AGENT_API_KEY=

# Optional: a resources file inside the container, and the Playwright storage
# state of the XP login as one masked value (the file contents, not a path).
EXTRACTKIT_RESOURCES=
EXTRACTKIT_STORAGE_STATE_JSON=

# Only for the optional `xp` service in compose.example.yml. Pick the tag that
# matches the app's xpVersion; there is no default.
XP_IMAGE_TAG=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "99x.extract.domain-packet-index/v1",
  "title": "domain packet index v1",
  "type": "object",
  "required": ["schema", "modules"],
  "properties": {
    "schema": { "const": "99x.extract.domain-packet-index/v1" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "file", "bytes", "files", "exports", "rules"],
        "properties": {
          "module": { "type": "string" },
          "file": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "files": { "type": "integer", "minimum": 0 },
          "exports": { "type": "integer", "minimum": 0 },
          "rules": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "additionalProperties": true
}

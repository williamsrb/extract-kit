{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "99x.extract.surface/v1",
  "title": "stack-agnostic surface",
  "type": "object",
  "required": ["id", "kind", "entry", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "entry": { "type": "string" },
    "composition": { "type": "array" },
    "contentTypes": { "type": "array" },
    "states": { "type": "array" },
    "integrations": { "type": "array" },
    "evidence": { "type": "array" },
    "status": {
      "type": "string",
      "enum": ["live", "dead", "conditional", "unverified-live"]
    },
    "stackRef": { "type": "object" }
  },
  "additionalProperties": true
}

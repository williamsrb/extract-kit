{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extractkit.agent-task/v1",
  "title": "agent task v1",
  "type": "object",
  "required": ["id", "title", "after", "reads", "writes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "title": { "type": "string", "minLength": 1 },
    "after": { "type": "string", "minLength": 1 },
    "reads": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "writes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "done": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "done_check": { "enum": ["rules_named", "exclude_decided", "live_config_written", "specs_enriched"] },
    "rerun": { "type": "string", "minLength": 1 },
    "promote": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "optional": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}

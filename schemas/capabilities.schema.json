{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extractkit.capabilities/v1",
  "title": "business capabilities v1",
  "type": "object",
  "required": ["schema", "capabilities"],
  "properties": {
    "schema": { "const": "extractkit.capabilities/v1" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "not": { "const": "packet" } },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extractkit.inventory/v1",
  "title": "static inventory",
  "type": "object",
  "required": ["schema", "resources"],
  "$defs": {
    "field": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "name",
            "type"
          ]
        },
        {
          "required": [
            "mixin"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "occurrences": {
          "$ref": "#/$defs/occurrences"
        },
        "selection": {
          "$ref": "#/$defs/occurrences"
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "fromMixin": {
          "type": "string"
        },
        "fieldSet": {
          "type": "string"
        },
        "helpText": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "expanded": {
          "type": "boolean"
        },
        "mixin": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "items"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "default": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/field"
                }
              }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "additionalProperties": true
    },
    "occurrences": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "schema": { "const": "extractkit.inventory/v1" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "path"],
        "properties": {
          "kind": { "type": "string" },
          "name": { "type": "string" },
          "displayName": { "type": "string" },
          "path": { "type": "string" },
          "app": { "type": "string" },
          "form": { "type": "array", "items": { "$ref": "#/$defs/field" } },
          "regions": { "type": "array", "items": { "type": "string" } },
          "xData": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "allowContentTypes": { "type": "string" }
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extractkit.profile/v1",
  "title": "extractkit profile (composed)",
  "type": "object",
  "required": ["name", "pipeline", "adapters"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "lineage": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "todo": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provides"],
        "properties": {
          "provides": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "optional": { "type": "boolean" },
          "probe": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "python_modules": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "python": { "type": "string", "pattern": "^(>=|>|<=|<|==)\\d+(\\.\\d+)*$" }
        },
        "additionalProperties": true
      }
    },
    "pipeline": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "slots": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "command": { "enum": ["doctor", "context", "agent", "check", "promote"] }
        },
        "oneOf": [
          { "required": ["slots"], "not": { "required": ["command"] } },
          { "required": ["command"], "not": { "required": ["slots"] } }
        ],
        "additionalProperties": false
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "null"]
      }
    }
  }
}
